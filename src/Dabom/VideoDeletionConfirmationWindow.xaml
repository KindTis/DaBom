<Window x:Class="Dabom.VideoDeletionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영상 삭제"
        Icon="Assets/Dabom.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        AutomationProperties.Name="영상 삭제"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="영상을 삭제할까요?"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="16,12"
                Background="{StaticResource RaisedBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
            <TextBlock x:Name="FileNameText"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="2"
                   Margin="0,16,0,0"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Content="취소"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="영상 삭제 취소" />
            <Button x:Name="ConfirmButton"
                    MinWidth="140"
                    Click="OnConfirm">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background"
                                Value="{StaticResource CloseHoverBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
