<Window x:Class="Dabom.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DABOM 정보" Icon="Assets/Dabom.ico"
        Width="560" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="DABOM" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding VersionText}" Margin="0,8,0,0" />
            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                       Text="지정한 보관 위치의 영화, 드라마, 애니메이션을 찾아 메타데이터와 포스터를 함께 관리하는 Windows 데스크톱 앱입니다." />
            <Image Source="Assets/TmdbLogo.png" Width="96" Height="36"
                   Stretch="Uniform" Margin="0,28,0,12"
                   HorizontalAlignment="Left" />
            <TextBlock>
                <Hyperlink NavigateUri="https://www.themoviedb.org/"
                           RequestNavigate="OnRequestNavigate">TMDB 웹사이트</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
            <Button Content="닫기" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,28,0,0" />
        </StackPanel>
    </Grid>
</Window>
