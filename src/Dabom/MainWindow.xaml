<Window x:Class="Dabom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="clr-namespace:Dabom.Main"
        xmlns:library="clr-namespace:Dabom.Library"
        Title="DABOM" Width="1440" Height="1000" MinWidth="760" MinHeight="640"
        Style="{StaticResource {x:Type Window}}"
        PreviewKeyDown="OnPreviewKeyDown" Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PageBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="999"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PrimaryButtonTranslate" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PrimaryButtonShadow"
                                                  BlurRadius="18" ShadowDepth="8"
                                                  Direction="270" Opacity="0.36" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background"
                                        Value="{StaticResource TextBrush}" />
                                <Setter TargetName="PrimaryButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush"
                                        Value="{StaticResource TextBrush}" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource PageBrush}" ClipToBounds="True">
        <Border x:Name="AmbientBaseLayer" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF151617" Offset="0" />
                    <GradientStop Color="#FF0E0F10" Offset="0.66" />
                    <GradientStop Color="#FF090A0B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Ellipse x:Name="AmbientTopGlow" Width="1040" Height="720"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-330,-300,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#305D6061" Offset="0" />
                    <GradientStop Color="#005D6061" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="820" Height="560" HorizontalAlignment="Left"
                 VerticalAlignment="Bottom" Margin="-360,0,0,-300"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1F4D5051" Offset="0" />
                    <GradientStop Color="#004D5051" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="DustCanvas" IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1720" Margin="32,18,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="62">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DABOM" FontSize="20" FontWeight="Bold" />
                        <Border Width="42" Height="1" Margin="18,1,0,0"
                                Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="내가 고른 영상들을 위한 작은 상영관"
                                   Margin="15,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Button Content="보관 위치 설정" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="OnToggleLocations" />
                </Grid>

                <Border x:Name="FeaturedHero" Grid.Row="1" Margin="0,28,0,0" MinHeight="392"
                        CornerRadius="28"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Background="#FF171819" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="38" ShadowDepth="16"
                                          Direction="270" Opacity="0.34" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeaturedVideo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid DataContext="{Binding FeaturedVideo}">
                        <Image x:Name="FeaturedBackdrop" Source="{Binding Poster}"
                               Height="392"
                               Stretch="UniformToFill" Opacity="0.34"
                               IsHitTestVisible="False">
                            <Image.Effect>
                                <BlurEffect Radius="14" />
                            </Image.Effect>
                        </Image>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#EC171819" Offset="0" />
                                    <GradientStop Color="#E6171819" Offset="0.47" />
                                    <GradientStop Color="#F5161718" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="210" Height="315" CornerRadius="16"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Background="{StaticResource SurfaceBrush}">
                                <Grid>
                                    <Border Margin="1" CornerRadius="15">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="NO POSTER" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPoster}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="50,0,0,0"
                                        VerticalAlignment="Center">
                            <TextBlock Text="다음에 볼 영상" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OriginalTitle}"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="58"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,0">
                                <Run Text="{Binding ReleaseYear, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Director, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Record.Synopsis}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" MaxWidth="650" Margin="0,18,0,0"
                                       HorizontalAlignment="Left" />
                            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                    Command="{Binding DataContext.PlayFeaturedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,26,0,0" HorizontalAlignment="Left"
                                    AutomationProperties.Name="재생하기">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Margin="0,0,9,0"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M 7 5 L 19 12 L 7 19 Z" />
                                    <TextBlock Text="재생하기" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,28,0,0" MinHeight="380" Padding="50"
                        CornerRadius="28" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Background="#FF171819">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Locations.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Text="당신의 영상을 한곳에서" FontSize="42"
                                   FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="보관 위치를 추가하면 DABOM이 영상을 찾아 정리합니다. 원본 파일은 변경하지 않습니다."
                                   Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="16" />
                        <Button Content="보관 위치 추가" Click="OnAddLocation"
                                IsEnabled="{Binding CanMutateLibrary}"
                                HorizontalAlignment="Center" Margin="0,28,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,28,0,0" MinHeight="380" Padding="50"
                        CornerRadius="28" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Background="#FF171819">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeaturedVideo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Locations.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="지원하는 영상이 없습니다" FontSize="34"
                                   FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="MP4, MKV, AVI, MOV, WMV, M4V 파일을 확인합니다."
                                   Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="폴더 다시 확인" Command="{Binding RescanCommand}"
                                HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="LibraryToolbar" Grid.Row="2" Margin="0,24,0,0"
                        Padding="18,15" CornerRadius="18"
                        Background="#E6121314"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="9"
                                          Direction="270" Opacity="0.28" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="내 영상" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" FontSize="22" FontWeight="SemiBold">
                                    <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                                    <Run Text="편" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="현재 조건의 영상을 표시하고 있습니다."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}" />
                        </Grid>

                        <Border Grid.Column="1" Height="54" Margin="22,0"
                                CornerRadius="14" Background="#B8141516"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" Margin="18,0,12,0"
                                      VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Margin="1,1,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                                    <Line X1="11" Y1="11" X2="17" Y2="17"
                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                                </Grid>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         Height="52" Padding="0"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="영상 검색"
                                         ToolTip="제목, 감독, 배우 검색 (Ctrl+K)"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" Text="제목, 감독, 배우 이름으로 검색"
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2" Margin="12,0,18,0" Padding="7,4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{StaticResource RaisedBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <TextBlock Text="Ctrl K" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="정렬" Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Width="120" Height="40"
                                      Style="{StaticResource ReferenceSortComboBoxStyle}"
                                      AutomationProperties.Name="정렬"
                                      SelectedValue="{Binding SelectedSort}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="제목" Tag="{x:Static library:VideoSort.Title}" />
                                <ComboBoxItem Content="개봉일" Tag="{x:Static library:VideoSort.ReleaseDate}" />
                                <ComboBoxItem Content="파일 수정일" Tag="{x:Static library:VideoSort.FileModified}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="VideoList" Grid.Row="3" Margin="0,30,0,0"
                         BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding VisibleVideos}"
                         SelectedItem="{Binding SelectedVideo}"
                         KeyDown="OnVideoListKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.Template>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Margin" Value="0,0,22,42" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick" Handler="OnVideoDoubleClick" />
                            <EventSetter Event="MouseEnter" Handler="OnCardEnter" />
                            <EventSetter Event="MouseMove" Handler="OnCardMove" />
                            <EventSetter Event="MouseLeave" Handler="OnCardLeave" />
                            <EventSetter Event="GotKeyboardFocus" Handler="OnCardFocus" />
                            <EventSetter Event="LostKeyboardFocus" Handler="OnCardBlur" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ponytail: 화면용 포스터는 240px로 제한한다. 그래도 1,000개 실측이 실패할 때만 가상화 패널로 교체한다. -->
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type main:VideoItemViewModel}">
                            <StackPanel Width="175">
                                <Border Width="175" Height="262.5" CornerRadius="16"
                                        Background="{StaticResource SurfaceBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                                    <Setter Property="BorderThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Border Margin="1" CornerRadius="15">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="NO POSTER" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPoster}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="5,15,5,0" />
                                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="5,7,5,0">
                                    <Run Text="{Binding ReleaseYear, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Director, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="4" MinHeight="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{Binding LastScanText}" />
                        <TextBlock Text="폴더 확인 중…" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="OnToggleWarnings" Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding Warnings.Count, Mode=OneWay, StringFormat='경고 {0}건'}">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Warnings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock>
                                <Run Text="경고 " />
                                <Run Text="{Binding Warnings.Count, Mode=OneWay}" />
                                <Run Text="건" />
                            </TextBlock>
                        </Button>
                        <Button Content="폴더 다시 확인" Command="{Binding RescanCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Popup x:Name="LocationsPopup" Placement="MousePoint" StaysOpen="False"
               AllowsTransparency="True">
            <Border Width="370" Padding="20" CornerRadius="18"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="#FF151617">
                <StackPanel>
                    <TextBlock Text="보관 위치 설정" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Locations}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <Button DockPanel.Dock="Right" Content="제거" Tag="{Binding}"
                                            Click="OnRemoveLocation"
                                            IsEnabled="{Binding DataContext.CanMutateLibrary, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="보관 위치 추가" Click="OnAddLocation" Margin="0,16,0,0"
                            IsEnabled="{Binding CanMutateLibrary}" />
                    <TextBlock Text="탐색 중에는 위치를 변경할 수 없습니다."
                               Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="WarningsPopup" Placement="MousePoint" StaysOpen="False"
               AllowsTransparency="True">
            <Border Width="520" MaxHeight="420" Padding="20" CornerRadius="18"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="#FF151617">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="확인하지 못한 항목" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ListBox x:Name="WarningsList" Grid.Row="1"
                             ItemsSource="{Binding Warnings}" DisplayMemberPath="DisplayText"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="CardPopup" AllowsTransparency="True" Placement="Right"
               StaysOpen="True" IsHitTestVisible="False" HorizontalOffset="12">
            <Border Width="430" CornerRadius="18"
                    BorderBrush="#33E7E5DF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF141516" Offset="0" />
                        <GradientStop Color="#FF262729" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="42" ShadowDepth="16"
                                      Direction="270" Opacity="0.62" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="126" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="18,0,0,18"
                            Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Border Margin="1" CornerRadius="17,0,0,17">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="NO POSTER" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPoster}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="25,23,25,21">
                        <TextBlock Text="{Binding OriginalTitle}" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="22"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Border BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="상영일" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseDateText}"
                                           FontSize="11" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="감독" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Director}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="주요 배우" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding ActorsText}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="영상" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="2" FontSize="11">
                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                    <Run Text=" · 1개 파일" />
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="시놉시스" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Record.Synopsis}" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                                           FontSize="11" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
