<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Dabom"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <SolidColorBrush x:Key="PageBrush" Color="#0E0F10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202123" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#2A2B2D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7E5DF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#929391" />
    <SolidColorBrush x:Key="AccentBrush" Color="#CBC9C2" />
    <SolidColorBrush x:Key="LineBrush" Color="#24E7E5DF" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#FF8B1E2D" />
    <SolidColorBrush x:Key="ToastSuccessBrush" Color="#72C990" />
    <SolidColorBrush x:Key="ToastWarningBrush" Color="#E2B65B" />
    <SolidColorBrush x:Key="ToastErrorBrush" Color="#E58A94" />
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="HeroCornerRadius">28</CornerRadius>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbSurface"
                            Width="6" MinHeight="32"
                            CornerRadius="3"
                            Background="{StaticResource MutedBrush}"
                            Opacity="0.62" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface"
                                    Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface"
                                    Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="8" Background="Transparent">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Style="{StaticResource ScrollBarPageButtonStyle}"
                                            Command="{x:Static ScrollBar.PageUpCommand}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource VerticalScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Style="{StaticResource ScrollBarPageButtonStyle}"
                                            Command="{x:Static ScrollBar.PageDownCommand}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WindowCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="CaptionHover"
                                Background="{TemplateBinding Background}"
                                Opacity="0" />
                        <Border x:Name="CaptionFocus"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionHover"
                                    Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="local:WindowChromeSupport.IsCaptionHovered"
                                 Value="True">
                            <Setter TargetName="CaptionHover"
                                    Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionHover"
                                    Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="local:WindowChromeSupport.IsCaptionPressed"
                                 Value="True">
                            <Setter TargetName="CaptionHover"
                                    Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CaptionFocus"
                                    Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource WindowCaptionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource CloseHoverBrush}" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PageBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="local:WindowChromeSupport.IsEnabled" Value="True" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="40"
                                    ResizeBorderThickness="6"
                                    GlassFrameThickness="0"
                                    CornerRadius="0"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="WindowTitleBar"
                                    Grid.Row="0"
                                    Height="40"
                                    Background="{StaticResource PageBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Width="16" Height="16"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center"
                                           Source="{TemplateBinding Icon}"
                                           IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding Title}"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" />

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal">
                                        <Button x:Name="PART_MinimizeButton"
                                                Style="{StaticResource WindowCaptionButtonStyle}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                AutomationProperties.Name="최소화">
                                            <Path Width="10" Height="1"
                                                  Stretch="Fill"
                                                  Stroke="{StaticResource TextBrush}"
                                                  StrokeThickness="1"
                                                  Data="M 0,0.5 H 10" />
                                        </Button>

                                        <Button x:Name="PART_MaximizeRestoreButton"
                                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}"
                                                       BasedOn="{StaticResource WindowCaptionButtonStyle}">
                                                    <Setter Property="Command"
                                                            Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                                                    <Setter Property="AutomationProperties.Name"
                                                            Value="최대화" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            Value="Maximized">
                                                            <Setter Property="Command"
                                                                    Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                                            <Setter Property="AutomationProperties.Name"
                                                                    Value="복원" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource TextBrush}"
                                                  StrokeThickness="1">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}">
                                                        <Setter Property="Data"
                                                                Value="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                Value="Maximized">
                                                                <Setter Property="Data"
                                                                        Value="M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>

                                        <Button x:Name="PART_CloseButton"
                                                Style="{StaticResource WindowCloseButtonStyle}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                AutomationProperties.Name="닫기">
                                            <Path Width="10" Height="10"
                                                  Stretch="Fill"
                                                  Stroke="{StaticResource TextBrush}"
                                                  StrokeThickness="1"
                                                  Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter x:Name="WindowContentPresenter"
                                                  ContentSource="Content"
                                                  Margin="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                   Path=(local:WindowChromeSupport.LegacyContentMargin)}" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_MinimizeButton"
                                    Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaximizeRestoreButton"
                                    Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_MaximizeRestoreButton"
                                    Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowContentPresenter"
                                    Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ResizeMode" Value="NoResize">
                <Setter Property="shell:WindowChrome.WindowChrome">
                    <Setter.Value>
                        <shell:WindowChrome CaptionHeight="40"
                                            ResizeBorderThickness="0"
                                            GlassFrameThickness="0"
                                            CornerRadius="0"
                                            UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource RaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#B8141516" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#B8141516" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="CalendarStyle">
            <Setter.Value>
                <Style TargetType="Calendar">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="DatePickerBorder"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Padding="{TemplateBinding Padding}"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalContentAlignment="Stretch"
                                                   VerticalContentAlignment="Center" />
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1,0,0,0"
                                        AutomationProperties.Name="달력 열기"
                                        Focusable="False">
                                    <Path Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.2"
                                          Data="M 1,3 L 13,3 L 13,13 L 1,13 Z M 1,6 L 13,6 M 4,1 L 4,4 M 10,1 L 10,4" />
                                </Button>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DatePickerBorder}"
                               PopupAnimation="Fade"
                               StaysOpen="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DatePickerBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DatePickerBorder"
                                    Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <Grid Margin="14,0,10,0">
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" />
                                            <TextBlock Text="⌄" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Padding="4"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{StaticResource RaisedBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ReferenceSortComboBoxStyle" TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#E0222325" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="SortControlBorder"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <Grid Margin="13,0,12,0">
                                            <ContentPresenter
                                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                VerticalAlignment="Center" />
                                            <Path Width="8" Height="5" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Stretch="Fill"
                                                  Stroke="{StaticResource MutedBrush}" StrokeThickness="1"
                                                  Data="M 0 0 L 4 4 L 8 0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SortControlBorder" Property="Background"
                                                    Value="#FF2A2B2D" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Margin="0,6,0,0" Padding="4"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{StaticResource RaisedBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{StaticResource SurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="#24CBC9C2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
