<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBrush" Color="#0E0F10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202123" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#2A2B2D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7E5DF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#929391" />
    <SolidColorBrush x:Key="AccentBrush" Color="#CBC9C2" />
    <SolidColorBrush x:Key="LineBrush" Color="#24E7E5DF" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PageBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#B8141516" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    </Style>
</ResourceDictionary>
